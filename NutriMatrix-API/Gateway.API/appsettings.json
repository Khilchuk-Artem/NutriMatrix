{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  
    "ReverseProxy": {
      "Routes": [
        {
          "RouteId": "auth-api-route",
          "ClusterId": "auth-api-cluster",
          "Match": {
            "Path": "/auth/{**catch-all}"
          }
        },
        {
          "RouteId": "foodcatalog-api-route",
          "ClusterId": "foodcatalog-api-cluster",
          "Match": {
            "Path": "/foodcatalog/{**catch-all}"
          }
        },
        {
          "RouteId": "foodrecords-api-route",
          "ClusterId": "foodrecords-api-cluster",
          "Match": {
            "Path": "/foodrecords/{**catch-all}"
          }
        },
        {
          "RouteId": "recommendation-api-route",
          "ClusterId": "recommendation-api-cluster",
          "Match": {
            "Path": "/recommendation/{**catch-all}"
          }
        }
      ],
      "Clusters": {
        "auth-api-cluster": {
          "Destinations": {
            "auth-api-destination": {
              "Address": "http://localhost:5050/"
            }
          }
        },
        "foodcatalog-api-cluster": {
          "Destinations": {
            "foodcatalog-api-destination": {
              "Address": "http://localhost:5051/"
            }
          }
        },
        "foodrecords-api-cluster": {
          "Destinations": {
            "foodrecords-api-destination": {
              "Address": "http://localhost:5052/"
            }
          }
        },
        "recommendation-api-cluster": {
          "Destinations": {
            "recommendation-api-destination": {
              "Address": "http://localhost:5053/"
            }
          }
        }
      }
    }
  ,
  "AllowedHosts": "*"
}
